{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GDKWINDOWING_ANDROID_BUILD_TESTS": "ON",
        "GDKWINDOWING_ANDROID_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux / gcc",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    },
    {
      "name": "linux-docs",
      "displayName": "Linux / documentation",
      "inherits": "linux-gcc",
      "cacheVariables": {
        "GDKWINDOWING_ANDROID_BUILD_TESTS": "OFF",
        "GDKWINDOWING_ANDROID_BUILD_DOCS": "ON"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android / arm64-v8a / NDK clang",
      "description": "Set ANDROID_NDK_HOME to an NDK (r23 or later). ctest runs the tests on the device or emulator adb is connected to.",
      "inherits": "base",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/jfc-cmake/toolchains/toolchain-android.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    },
    {
      "name": "android-armv7",
      "displayName": "Android / armeabi-v7a / NDK clang",
      "inherits": "android-arm64",
      "cacheVariables": {
        "ANDROID_ABI": "armeabi-v7a"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android / x86_64 / NDK clang",
      "inherits": "android-arm64",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64"
      }
    },
    {
      "name": "android-x86",
      "displayName": "Android / x86 / NDK clang",
      "inherits": "android-arm64",
      "cacheVariables": {
        "ANDROID_ABI": "x86"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-docs",
      "configurePreset": "linux-docs"
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64"
    },
    {
      "name": "android-armv7",
      "configurePreset": "android-armv7"
    },
    {
      "name": "android-x86_64",
      "configurePreset": "android-x86_64"
    },
    {
      "name": "android-x86",
      "configurePreset": "android-x86"
    }
  ],
  "testPresets": [
    {
      "name": "android-x86_64",
      "configurePreset": "android-x86_64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
